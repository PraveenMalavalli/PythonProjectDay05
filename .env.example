# Copy to .env. The local Ollama model requires no paid API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_CAP_SECONDS=8

# Optional: required ONLY for the hosted-vs-local comparison experiment.
HOSTED_BASE_URL=https://openrouter.ai/api/v1
HOSTED_MODEL=
HOSTED_API_KEY=
HOSTED_FALLBACK_MODELS=
